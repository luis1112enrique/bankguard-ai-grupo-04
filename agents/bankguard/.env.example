# Copy only the variables you need into the repository-level .env file.
# Never commit real credentials.

INDEX_NAME=tec-vdb
PINECONE_API_KEY=replace-with-your-pinecone-api-key
PINECONE_NAMESPACE=mx-pld-ft
RAG_CORPUS_ID=mx-pld-ft

OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_NUM_PREDICT=900
EMBEDDING_MODEL=bge-large
BANKGUARD_RETRIEVER_K=5

# Paths are resolved from the repository root and cannot escape it.
BANKGUARD_TRANSACTIONS_CSV=agents/data/bank_transactions.csv
BANKGUARD_PROFILES_CSV=agents/data/client_profiles.csv
BANKGUARD_OUTPUTS_DIR=outputs
BANKGUARD_CHARTS_DIR=outputs/charts
BANKGUARD_ALERTS_DIR=outputs/alerts
BANKGUARD_RISK_CONFIG=agents/bankguard/risk_config.json

# Keep external tracing disabled unless a valid setup is intentionally configured.
BANKGUARD_TRACING=false
