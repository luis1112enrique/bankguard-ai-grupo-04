# BankGuard AI: copy this file to .env in the repository root.
# Replace placeholders locally; never commit real credentials.

# Required only for live regulatory retrieval. Use your own existing index.
PINECONE_API_KEY=replace-with-your-pinecone-api-key
INDEX_NAME=your-pinecone-index
PINECONE_NAMESPACE=mx-pld-ft
RAG_CORPUS_ID=mx-pld-ft

# Ollama must provide both models for live multi-agent and RAG execution.
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_NUM_PREDICT=900
EMBEDDING_MODEL=bge-large
BANKGUARD_RETRIEVER_K=5

# Paths resolve from the repository root and must remain inside it.
BANKGUARD_TRANSACTIONS_CSV=agents/data/bank_transactions.csv
BANKGUARD_PROFILES_CSV=agents/data/client_profiles.csv
BANKGUARD_OUTPUTS_DIR=outputs
BANKGUARD_CHARTS_DIR=outputs/charts
BANKGUARD_ALERTS_DIR=outputs/alerts
BANKGUARD_RISK_CONFIG=agents/bankguard/risk_config.json

# Keep tests and local execution free of external tracing by default.
BANKGUARD_TRACING=false
AGENTIC_RAG_TRACING=false
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
RUN_BANKGUARD_INTEGRATION=0

# Optional ingestion settings. Ingestion writes to Pinecone; runtime only reads.
# This template disables removal of previously indexed chunks.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=200
DELETE_STALE_VECTORS=false
